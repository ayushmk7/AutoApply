# Copy to `backend/server/.env`. All secrets are yours; nothing sensitive is committed.

NODE_ENV=development
PORT=3001
# Optional bind address (Docker / IPv4): HOST=0.0.0.0
LOG_LEVEL=info

# Required when demo auth is available (development, or ENABLE_DEMO_SKIP in production).
DEMO_JWT_SECRET=change-me-to-a-long-random-string

API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

REDIS_URL=redis://127.0.0.1:6379

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# FIREBASE_SERVICE_ACCOUNT_PATH=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

GCS_BUCKET=

ANTHROPIC_API_KEY=
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
APOLLO_API_KEY=
GITHUB_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CAPTCHA_2CAPTCHA_KEY=

MOCK_AGENTMAIL=false
MOCK_CLASSIFY_INBOUND_EMAIL=false
ENABLE_DEMO_SKIP=false
# DEMO_TOKEN_TTL_SECONDS=86400

GITHUB_SCRAPE_REPOS=
# SCRAPE_INTERVAL_MS=10800000
# SCRAPE_JOB_BACKOFF_DELAY_MS=120000

AGENTMAIL_API_BASE=https://api.agentmail.dev

TOKEN_ENCRYPTION_KEY=
GOOGLE_SHEETS_REDIRECT_URI=
OAUTH_STATE_SECRET=

# Phase 16 — quotas & Playwright
# PLAYWRIGHT_MAX_CONTEXTS=50
# ATS_DOMAIN_HOURLY_CAP=5
# DEMO_DAILY_APPLY_CAP=5
# DEMO_ATS_DOMAIN_HOURLY_CAP=2
# DEMO_PLAYWRIGHT_MAX_CONTEXTS=2
# PLAYWRIGHT_SLOT_WAIT_MS_STEP=250
# PLAYWRIGHT_SLOT_WAIT_MAX_MS=120000
# ATS_DOMAIN_QUOTA_TTL_MS=3600000
# DAILY_QUOTA_REDIS_TTL_BUFFER_MS=3600000
# MANUAL_PLACEHOLDER_JOB_URL=https://autoapply.invalid/manual-paste
# DEFAULT_PROFILE_DAILY_LIMIT=20
# DEFAULT_AUTO_APPLY_THRESHOLD=75
# ATS_TARGET_SCORE_PERCENT=70
# ATS_REVISION_MAX_LOOPS=2
# PLAYWRIGHT_LOCAL_CONTEXT_CAP=15
# PLAYWRIGHT_PAGE_GOTO_TIMEOUT_MS=60000
# PLAYWRIGHT_USER_AGENT=Mozilla/5.0 ...

# Rate limits (express-rate-limit)
# SKIP_AUTH_RATE_LIMIT_WINDOW_MS=900000
# SKIP_AUTH_RATE_LIMIT_MAX_PROD=20
# SKIP_AUTH_RATE_LIMIT_MAX_DEV=100
# APPLICATION_RETRY_RATE_LIMIT_WINDOW_MS=900000
# APPLICATION_RETRY_RATE_LIMIT_MAX=30
# AGENTMAIL_WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
# AGENTMAIL_WEBHOOK_RATE_LIMIT_MAX=600

# Phase 17 — optional protection for GET /api/metrics
# METRICS_API_KEY=

# LISTINGS_QUERY_MAX_DOCS=500
# BULLMQ_REMOVE_ON_COMPLETE=500
# BULLMQ_REMOVE_ON_FAIL=200
# DEFAULT_LISTING_URGENCY_SCORE=50
# DEFAULT_LISTING_URGENCY_LABEL=medium
# EXTRACTION_CONFIDENCE_THRESHOLD=0.35
