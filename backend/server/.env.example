# Backend — copy to `backend/server/.env`. Never commit `.env`.
# Validated in `src/lib/config.ts` (production requires more keys than local dev).

# --- Core ---
NODE_ENV=development
PORT=3001
# Docker / bind all interfaces: HOST=0.0.0.0
LOG_LEVEL=info

API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

REDIS_URL=redis://127.0.0.1:6379

# --- Secrets (generate random strings; use a password manager in prod) ---
# Required whenever demo auth is on (dev default, or ENABLE_DEMO_SKIP in prod).
DEMO_JWT_SECRET=change-me-to-a-long-random-string
# 64 hex chars — encrypts Google OAuth tokens at rest (required in production).
TOKEN_ENCRYPTION_KEY=
# Signs OAuth `state` (required in production; can match DEMO_JWT_SECRET in dev only).
OAUTH_STATE_SECRET=

# --- Firebase Admin (Firestore / Auth on the server) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste multiline key with literal \n for newlines, or use a file/json variant below.
FIREBASE_PRIVATE_KEY=

# FIREBASE_SERVICE_ACCOUNT_PATH=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Local only — point Admin SDK at emulators (optional).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Google Cloud Storage (CVs, PDFs, screenshots; required in production) ---
GCS_BUCKET=

# --- Integrations (required in production; optional locally if you mock or skip features) ---
ANTHROPIC_API_KEY=
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
APOLLO_API_KEY=
GITHUB_TOKEN=
CAPTCHA_2CAPTCHA_KEY=

# --- Google OAuth (Sheets / Calendar flows; required in production) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Defaults to `${API_BASE_URL}/api/sheets/oauth/callback` if unset.
GOOGLE_SHEETS_REDIRECT_URI=
# Must match whichever public API domain serves `/api/sheets/oauth/callback` in prod.

# --- AgentMail ---
AGENTMAIL_API_BASE=https://api.agentmail.dev

# --- GitHub listing scrape (comma-separated owner/repo) ---
GITHUB_SCRAPE_REPOS=

# --- Local dev: save money / avoid external APIs ---
MOCK_AGENTMAIL=false
MOCK_CLASSIFY_INBOUND_EMAIL=false
ENABLE_DEMO_SKIP=false
# DEMO_TOKEN_TTL_SECONDS=86400

# --- Optional tuning (defaults are fine to start) ---
# SCRAPE_INTERVAL_MS=10800000
# SCRAPE_JOB_BACKOFF_DELAY_MS=120000

# Phase 16 — quotas & Playwright
# PLAYWRIGHT_MAX_CONTEXTS=50
# ATS_DOMAIN_HOURLY_CAP=5
# DEMO_DAILY_APPLY_CAP=5
# DEMO_ATS_DOMAIN_HOURLY_CAP=2
# DEMO_PLAYWRIGHT_MAX_CONTEXTS=2
# PLAYWRIGHT_SLOT_WAIT_MS_STEP=250
# PLAYWRIGHT_SLOT_WAIT_MAX_MS=120000
# ATS_DOMAIN_QUOTA_TTL_MS=3600000
# DAILY_QUOTA_REDIS_TTL_BUFFER_MS=3600000
# MANUAL_PLACEHOLDER_JOB_URL=https://autoapply.invalid/manual-paste
# DEFAULT_PROFILE_DAILY_LIMIT=20
# DEFAULT_AUTO_APPLY_THRESHOLD=75
# ATS_TARGET_SCORE_PERCENT=70
# ATS_REVISION_MAX_LOOPS=2
# PLAYWRIGHT_LOCAL_CONTEXT_CAP=15
# PLAYWRIGHT_PAGE_GOTO_TIMEOUT_MS=60000
# PLAYWRIGHT_USER_AGENT=Mozilla/5.0 ...

# Rate limits (express-rate-limit)
# SKIP_AUTH_RATE_LIMIT_WINDOW_MS=900000
# SKIP_AUTH_RATE_LIMIT_MAX_PROD=20
# SKIP_AUTH_RATE_LIMIT_MAX_DEV=100
# APPLICATION_RETRY_RATE_LIMIT_WINDOW_MS=900000
# APPLICATION_RETRY_RATE_LIMIT_MAX=30
# AGENTMAIL_WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
# AGENTMAIL_WEBHOOK_RATE_LIMIT_MAX=600

# GET /api/metrics — set to require header X-Metrics-Key
# METRICS_API_KEY=

# Public-facing URLs checklist (prod):
# - API_BASE_URL must be public and used by AgentMail webhook callbacks
# - FRONTEND_URL must match browser origin for WS origin checks
# - GOOGLE_SHEETS_REDIRECT_URI must be registered in Google OAuth app

# LISTINGS_QUERY_MAX_DOCS=500
# BULLMQ_REMOVE_ON_COMPLETE=500
# BULLMQ_REMOVE_ON_FAIL=200
# DEFAULT_LISTING_URGENCY_SCORE=50
# DEFAULT_LISTING_URGENCY_LABEL=medium
# EXTRACTION_CONFIDENCE_THRESHOLD=0.35
