# Frontend (Vite) — copy to `.env` at the repo root. Never commit `.env`.
# Backend secrets live in `backend/server/.env` (see `backend/server/.env.example`).

# --- API (optional) ---
# Empty = same-origin `/api` and `/ws` (typical: Vite dev proxy to the backend).
# VITE_API_URL=

# --- Dev server & proxy (optional) ---
# VITE_DEV_PORT=5173
# VITE_DEV_PROXY_API=http://127.0.0.1:3001
# VITE_DEV_PROXY_WS=ws://127.0.0.1:3001

# --- Firebase Web SDK (needed for email/Google login in the UI) ---
# From Firebase console → Project settings → Your apps → Web app config.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_STORAGE_BUCKET=

# --- Production frontend ---
# If the UI is not served from the same host as the API, set the public API origin:
# VITE_API_URL=https://api.yourdomain.com

import { initializeApp } from "firebase/app";
import { getAnalytics } from "firebase/analytics";
// TODO: Add SDKs for Firebase products that you want to use
// https://firebase.google.com/docs/web/setup#available-libraries

// Your web app's Firebase configuration
// For Firebase JS SDK v7.20.0 and later, measurementId is optional
const firebaseConfig = {
  apiKey: "AIzaSyD8fJiFMvpY_330am2SFo2Jp3OzBLxsHAU",
  authDomain: "autoapply-c4ee0.firebaseapp.com",
  projectId: "autoapply-c4ee0",
  storageBucket: "autoapply-c4ee0.firebasestorage.app",
  messagingSenderId: "822180110345",
  appId: "1:822180110345:web:9dbee0c90c2424e5dcd8d8",
  measurementId: "G-TD00R6DKVX"
};

// Initialize Firebase
const app = initializeApp(firebaseConfig);
const analytics = getAnalytics(app);