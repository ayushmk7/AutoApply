# Root env for Vite (Phase 20). Copy to `.env` — never commit `.env`.

# Leave empty to use same-origin `/api` and `/ws` (Vite dev proxy).
# VITE_API_URL=

# Vite dev server / proxy targets (optional overrides)
# VITE_DEV_PORT=5173
# VITE_DEV_PROXY_API=http://127.0.0.1:3001
# VITE_DEV_PROXY_WS=ws://127.0.0.1:3001

# Firebase Web SDK (all required for email/Google login in the UI)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
